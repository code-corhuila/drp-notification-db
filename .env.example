# Liquibase needs collMod (validators). notification_app is readWrite only (Anexo J).
# Local: infra-mongo root. Do not put that password in the API .env.
LIQUIBASE_COMMAND_URL=mongodb://root:change-me-mongo@mongo:27017/notification?authSource=admin
LIQUIBASE_COMMAND_CHANGELOG_FILE=changelog/db.changelog-master.xml
LIQUIBASE_COMMAND_CHANGELOG_TABLE_NAME=databasechangelog_notification
NOTIFICATION_DB_NETWORK=drp-dev_default
